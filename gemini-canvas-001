def rodar_quiz(qtd):
    """Lógica principal do quiz."""
    limpar_tela()
    
    # Validação para não pedir mais questões do que existem
    qtd = min(qtd, len(banco_questoes))
    
    # Sorteio aleatório sem repetição
    indices_sorteados = random.sample(range(len(banco_questoes)), qtd)
    
    acertos = 0
    
    print(f"=== INICIANDO QUIZ DE {qtd} QUESTÕES ===\n")
    
    for i, idx in enumerate(indices_sorteados):
        questao = banco_questoes[idx]
        print(f"Questão {i+1}/{qtd}: {questao['p']}")
        
        # Embaralha as alternativas para não ficar viciado
        opcoes = questao['opts'].copy()
        random.shuffle(opcoes)
        
        # Mostra as opções
        for j, opt in enumerate(opcoes):
            print(f"   {j+1}) {opt}")
        
        # Coleta resposta
        while True:
            try:
                resposta_user = int(input("\nSua resposta (número): "))
                if 1 <= resposta_user <= 4:
                    break
                print("Por favor, digite um número entre 1 e 4.")
            except ValueError:
                print("Entrada inválida. Digite um número.")
        
        escolha_texto = opcoes[resposta_user - 1]
        
        # Verifica acerto
        if escolha_texto == questao['r']:
            print("\n✅ CORRETO!")
            acertos += 1
        else:
            print(f"\n❌ ERRADO. A resposta certa era: {questao['r']}")
        
        print("-" * 40)
        time.sleep(1.5) # Pausa dramática para ler o feedback
        limpar_tela()

    # Resultado Final
    nota = (acertos / qtd) * 10
    print("=== RESULTADO FINAL ===")
    print(f"Você acertou {acertos} de {qtd} questões.")
    print(f"Sua nota: {nota:.1f}")
    
    if nota == 10:
        print("🏆 PERFEITO! Você domina Sistemas Operacionais!")
    elif nota >= 7:
        print("👏 Muito bom! Continue estudando.")
    else:
        print("📚 Precisa revisar os tópicos de aprendizado.")
    
    pausar()

